POSTGRES_DB=twisted_vault
POSTGRES_USER=vault
POSTGRES_PASSWORD=replace-with-strong-db-password
DATABASE_URL=postgresql+psycopg2://vault:replace-with-strong-db-password@db:5432/twisted_vault
JWT_SECRET=replace-with-long-random-secret
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=12345
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-strong-keycloak-admin-password
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-strong-keycloak-db-password
KEYCLOAK_HOST=vault-auth.example.com
KEYCLOAK_PUBLIC_URL=https://vault-auth.example.com
KEYCLOAK_REALM=twisted-vault
KEYCLOAK_ISSUER_URL=https://vault-auth.example.com/realms/twisted-vault
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/twisted-vault/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=twisted-vault-frontend
VITE_KEYCLOAK_URL=https://vault-auth.example.com
VITE_KEYCLOAK_REALM=twisted-vault
VITE_KEYCLOAK_CLIENT_ID=twisted-vault-frontend
ALLOW_REGISTRATION=false
ACCESS_TOKEN_MINUTES=1440
CORS_ORIGINS=https://vault.example.com,http://localhost:8080
WEB_PORT=8080
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_COUNT=30
